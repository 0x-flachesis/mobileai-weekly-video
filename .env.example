# 複製為 .env 後依需填寫；不填任何 key 也能跑全流程（passthrough + edge-tts）。

# --- RSS 來源 ---
# FEED_URL=https://mobileai.net/feed/
# LOOKBACK_DAYS=7

# --- LLM（不填 → passthrough：直接使用 RSS 標題與摘要）---
# LLM_PROVIDER=openai-compatible          # openai-compatible | passthrough | mock
# LLM_BASE_URL=https://api.openai.com/v1  # GLM: https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini                   # GLM 例: glm-4-flash
# LLM_TEMPERATURE=0.4
#
# OpenRouter（自動在免費模型間 fallback）：LLM_MODEL 用逗號分隔多個 :free 模型，
# 限流或不可用時 OpenRouter 依序切換；實際路由到的模型會出現在 log。
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# --- TTS（不填 → 自動：有 MINIMAX_API_KEY 用 minimax，否則 edge-tts 免 key）---
# TTS_PROVIDER=edge                       # edge | minimax | openai-compatible | mock
# EDGE_TTS_VOICE=zh-TW-HsiaoChenNeural
# EDGE_TTS_BIN=                           # 例: /home/me/.local/bin/edge-tts

# MiniMax T2A v2（https://platform.minimax.cn/docs/api-reference/speech-t2a-http.md）
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.cn # 國際站: https://api.minimaxi.com
# MINIMAX_TTS_MODEL=speech-2.8-hd         # speech-2.8-hd | speech-2.8-turbo | speech-2.6-hd | ...
# MINIMAX_TTS_VOICE=male-qn-qingse
# MINIMAX_TTS_SPEED=1.0                   # 0.5 - 2
# MINIMAX_TTS_PITCH=0                     # -12 - 12

# OpenAI 相容 TTS（/audio/speech 端點）
# TTS_API_KEY=
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_SPEED=1.0

# --- mock 模式（單元測試 / dry-run）---
# MOCK_TTS_CPS=4.2
